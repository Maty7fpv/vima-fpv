+// Vima: klicovy snimek na zadost (viz video.c)
+int ser_rk_video_request_idr(int fd) {
+	int err = 0;
+	int id;
+
+	if (sock_read(fd, &id, sizeof(id)) == SOCKERR_CLOSED)
+		return -1;
+	err = rk_video_request_idr(id);
+	if (sock_write(fd, &err, sizeof(int)) == SOCKERR_CLOSED)
+		return -1;
+
+	return 0;
+}
