+// Vima: klicovy snimek na zadost prijimace (po ztrate paketu se obraz obnovi hned,
+// ne az s dalsim pravidelnym I-snimkem). bInstant = RK_TRUE tento cip neumi.
+// (Postupne obnovovani - RK_MPI_VENC_SetIntraRefresh - vrati 0, ale MPP v tomto SDK
+// klic rc:refresh_en nezna, takze nic nedela.)
+int rk_video_request_idr(int stream_id) {
+	int ret = RK_MPI_VENC_RequestIDR(stream_id, RK_FALSE);
+	if (ret)
+		LOG_ERROR("RK_MPI_VENC_RequestIDR(%d) error %#x\n", stream_id, ret);
+	return ret;
+}
