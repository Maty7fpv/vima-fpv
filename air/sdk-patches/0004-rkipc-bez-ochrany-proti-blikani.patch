+	if (!strcmp(value, "close")) {
+		// Vima: bez ochrany proti blikani - jinak AE drzi expozici v nasobcich 10 ms (50 Hz) a strop
+		// expozice z IQ (TimeDot 4 ms, nizsi zpozdeni) se neuplatni. Pod zarivkami muzou byt pruhy.
+		expSwAttr.stAuto.stAntiFlicker.enable = false;
+	} else if (!strcmp(value, "NTSC(60HZ)")) {
 		expSwAttr.stAuto.stAntiFlicker.enable = true;
 		expSwAttr.stAuto.stAntiFlicker.Frequency = AECV2_FLICKER_FREQUENCY_60HZ;
