+// Vima: zpozdeni na desce = cas vydani zakodovaneho snimku - PTS snimku z VI (CLOCK_MONOTONIC, us).
+// Kazdych 600 snimku (10 s pri 60 fps) prida radek do /tmp/vima-venc-lat.txt (max ~64 kB).
+static void vima_venc_lat(uint64_t pts) {
+	static int n;
+	static long long sum, mn, mx;
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	long long d = (long long)ts.tv_sec * 1000000 + ts.tv_nsec / 1000 - (long long)pts;
+	if (!n) {
+		sum = 0;
+		mn = LLONG_MAX;
+		mx = LLONG_MIN;
+	}
+	sum += d;
+	if (d < mn)
+		mn = d;
+	if (d > mx)
+		mx = d;
+	if (++n < 600)
+		return;
+	struct stat st;
+	FILE *f = fopen("/tmp/vima-venc-lat.txt",
+	                stat("/tmp/vima-venc-lat.txt", &st) == 0 && st.st_size > 65536 ? "w" : "a");
+	if (f) {
+		fprintf(f, "%ld wrap=%d n=%d avg=%lld min=%lld max=%lld us\n", (long)ts.tv_sec, enable_wrap, n,
+		        sum / n, mn, mx);
+		fclose(f);
+	}
+	n = 0;
+}
