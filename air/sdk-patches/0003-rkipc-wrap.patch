+// Vima: log do /tmp/vima-rkipc.log (max ~64 kB), cas = CLOCK_MONOTONIC jako u /tmp/vima-venc-lat.txt
+static void vima_log(const char *fmt, ...) {
+	struct timespec ts;
+	va_list ap;
+	struct stat st;
+	// velikost pred otevrenim: ftell hned po fopen("a") vraci na uClibc 0
+	FILE *f = fopen("/tmp/vima-rkipc.log",
+	                stat("/tmp/vima-rkipc.log", &st) == 0 && st.st_size > 65536 ? "w" : "a");
+	if (!f)
+		return;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	fprintf(f, "%ld.%03ld ", (long)ts.tv_sec, ts.tv_nsec / 1000000);
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fputc('\n', f);
+	fclose(f);
+}
