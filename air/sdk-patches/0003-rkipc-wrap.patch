+// video.source:enable_wrap = 1 a fps snimace <= video.source:wrap_max_fps (chybi = 0 = nikdy).
+static int vima_wrap_wanted(void) {
+	int fps = rk_param_get_int("isp.0.adjustment:fps", 30);
+	int max = rk_param_get_int("video.source:wrap_max_fps", 0);
+	return rk_param_get_int("video.source:enable_wrap", 0) && fps > 0 && fps <= max;
+}
